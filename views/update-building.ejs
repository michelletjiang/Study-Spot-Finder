<%# LEGACY - not used by the Vue demo: admin form to change a building's floors. Rendered by getBuilding in controllers/building-controller.js. The Vue page BuildingFormView.vue replaces it. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Update Floors</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
      <%# Only show the form when a building was found. %>
      <%  if(result.buildingname){ %>
    <h3>Update Building </h3>
    <%# The form posts to the legacy /update-building route. %>
    <form action="/update-building" method="POST">
        <table border="1">
            <tr>
                <th> Building Name :</th><td><%= result.buildingname %></td>
            </tr>
            <tr>
                <th>Postal Code: </th><td><%= result.postal %></td>
            </tr>
            <tr>
                <th>Number of Floors:</th><td><input type="text" name="floors" value = "<%= result.floors %>"></td>
            </tr>
            <%# A hidden field sends the postal code back so the server knows which building to update. %>
            <input type="hidden" name="postal" value="<%= result.postal %>">
            <tr>
                <td colspan="2"><button type="submit">Update Building</button></td>
            </tr>
        </table>
     
        
    </form>
     <% } %>


<br><br>

        
   
    
</body>
</html>