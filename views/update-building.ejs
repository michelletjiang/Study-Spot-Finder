<!DOCTYPE html>
<html lang="en">
<head>
    <title>Update Floors</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> |
            <a href="/admin/reports">Pending Reports</a> |
        <% } %>
        <a href="/favourites">Favourites</a> |
         <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Logout</button></form>
    </nav>
      <%  if(result.buildingname){ %>
    <h3>Update Building </h3>
    <form action="/update-building" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <table border="1">
            <tr>
                <th> Building Name :</th><td><%= result.buildingname %></td>
            </tr>
            <tr>
                <th>Postal Code: </th><td><%= result.postal %></td>
            </tr>
            <tr>
                <th>Number of Floors:</th><td><input type="text" name="floors" value = "<%= result.floors %>"></td>
            </tr>
            <input type="hidden" name="postal" value="<%= result.postal %>">
            <tr>
                <td colspan="2"><button type="submit">Update Building</button></td>
            </tr>
        </table>


    </form>
     <% } %>


<br><br>




</body>
</html>
