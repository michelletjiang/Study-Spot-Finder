<head>
    <title>Make Report</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <a href='/logout'>Logout</a>
    </nav>
    <br>
<h1>Report Review</h1>

<p>Review: <%= review.content %></p>

<form action="/reports/new/<%= review._id %>" method="POST">
  <label>Reason:</label>
  <select name="reason">
    <option value="Inaccurate">Inaccurate</option>
    <option value="Offensive">Offensive</option>
    <option value="Spam">Spam</option>
    <option value="Other">Other</option>
  </select>
  <br><br>
  <label>Description:</label>
  <br>
  <textarea name="description"></textarea>
  <br><br>
  <button type="submit">Submit Report</button>
</form>

<%= msg %>

</body>