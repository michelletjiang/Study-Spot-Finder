<%# The form posts to the controller, which validates fields, checks duplicates, hashes the password, and assigns Student. %>
<%- include('partials/header', { title: 'Create account' }) %><section class="auth-card wide"><p class="eyebrow">GET STARTED</p><h1>Create your account</h1><p class="muted">Student accounts are created safely by default.</p><% if (error && error.length) { %><div class="alert" role="alert"><% error.forEach(message => { %><p><%= message %></p><% }) %></div><% } %><form action="/register" method="post"><%# The session-bound token lets the server reject cross-site POSTs. %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="username">Username</label><input id="username" name="username" minlength="5" required autocomplete="username" value="<%= (form && form.username) || '' %>"><label for="email">Email address</label><input id="email" name="email" type="email" required autocomplete="email" value="<%= (form && form.email) || '' %>"><label for="password">Password <span class="hint">at least 8 characters</span></label><input id="password" name="password" type="password" minlength="8" required autocomplete="new-password"><fieldset><legend>School <span class="hint">choose up to 2</span></legend><% [['LKCSB','Lee Kong Chian School of Business'],['SCIS','School of Computing and Information Systems'],['SOSS','School of Social Sciences'],['SOA','School of Accountancy'],['SOE','School of Economics'],['YPHSL','Yong Pung How School of Law'],['CIS','College of Integrative Studies']].forEach(([value,label]) => { %><label class="check"><input type="checkbox" name="school" value="<%= value %>"><%= label %></label><% }) %></fieldset><button class="button" type="submit">Create account</button></form><p class="form-foot">Already registered? <a href="/login">Log in</a></p></section><%- include('partials/footer') %>