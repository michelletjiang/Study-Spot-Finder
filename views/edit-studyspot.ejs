<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Study Spot</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> |
            <a href="/admin/reports">Pending Reports</a> |
        <% } %>
        <a href="/favourites">Favourites</a> |
         <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Logout</button></form>
    </nav>
    <br>
    <% if (result) { %>
        <h3>Edit: <%= result.buildingName %>, <%= result.name %></h3>
        <form action="/edit-studyspot" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- hidden field to pass the id back to the POST route -->
            <input type="hidden" name="id" value="<%= result._id %>">
            <table border="1">
                <tr><th>Building Name:</th><th><%= result.buildingName %></th></tr>
                <tr><th>Name:</th><td><input type="text" name="name" value="<%= result.name %>"></td></tr>
                <tr><th>Floor:</th><td><input type="number" name="floor" value="<%= result.floor %>"></td></tr>
                <tr><th>Seat Count:</th><td><input type="number" name="seatCount" value="<%= result.seatCount %>"></td></tr>
                <tr><th>Power Socket:</th>
                    <td>
                        <select name="hasPowerSocket">
                            <option value="true"  <%= result.hasPowerSocket ? 'selected' : '' %>>Yes</option>
                            <option value="false" <%= !result.hasPowerSocket ? 'selected' : '' %>>No</option>
                        </select>
                    </td>
                </tr>
                <tr><th>Noise Level:</th>
                    <td>
                        <select name="noiseLevel">
                            <option value="Quiet"    <%= result.noiseLevel === 'Quiet'    ? 'selected' : '' %>>Quiet</option>
                            <option value="Moderate" <%= result.noiseLevel === 'Moderate' ? 'selected' : '' %>>Moderate</option>
                            <option value="Loud"     <%= result.noiseLevel === 'Loud'     ? 'selected' : '' %>>Loud</option>
                        </select>
                    </td>
                </tr>
                <tr><td colspan="2"><button type="submit">Update Study Spot</button></td></tr>
            </table>
        </form>
    <% } else { %>
        <p>Study spot not found.</p>
    <% } %>

</body>
</html>
