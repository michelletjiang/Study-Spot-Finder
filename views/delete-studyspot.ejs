<%# LEGACY - not used by the Vue demo: confirmation page before deleting a study spot. Rendered by showDeleteForm in controllers/studyspot-controller.js. The Vue page AdminSpotsView.vue replaces it. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Delete Study Spot</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
    <br>
    <%# Show the spot that is about to be deleted. %>
    <% if (result) { %>
        <h3>Delete: <%= result.buildingName %>, <%= result.name %></h3>
        Name: <%= result.name %><br>
        Building: <%= result.buildingName %><br>
        Floor: <%= result.floor %><br>
        Seats: <%= result.seatCount %><br>

        <%# The form posts to the legacy /delete-studyspot route. %>
        <form action="/delete-studyspot" method="POST">
            <!-- hidden field to pass the id back to the POST route -->
            <%# A hidden field sends the spot id back. %>
            <input type="hidden" name="id" value="<%= result._id %>">
            <p>Click Confirm to delete this study spot.</p>
            <button type="submit">Confirm</button>
        </form>
    <% } else { %>
        <p>Study spot not found.</p>
    <% } %>

    
</body>
</html>