<%# LEGACY - not used by the Vue demo: server-rendered login form. Rendered by loginGet in controllers/user-controller.js. The Vue page LoginView.vue replaces it. %>
<html>
    <head>
        <title>Login - Study Spot</title>
        <link rel="stylesheet" href="/styles.css">
</head>
    <body>
        <h1>SMU STUDY SPOT FINDER 📚 </h1>
        <h2>Login to Your Account</h2>

        <%# The form posts email and password to the legacy /login route. %>
        <form action="/login" method="POST">
            <table>
                <tr>
                    <td>Email:</td>
                    <td><input type="text" name="email"></td>
                </tr>
                <tr>
                    <td>Password:</td>
                    <td><input type="password" name="password"></td>
                </tr>
            </table>
            <br>
            <button type="submit">Login</button>

            <%# Show login error messages when the controller passed any. %>
            <% if (error && error.length > 0) { %>
                <ul>
                    <%# One list item per message. %>
                    <% error.forEach(err => { %>
                        <li><%= err %></li>
                    <% }) %>
                </ul>
            <% } %>
        </form>

        <%# Link to the legacy register page. %>
        <p>Don't have an account? <a href="/register">Register here</a></p>
    </body>
</html>