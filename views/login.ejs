<%- include('partials/header', { title: 'Log in' }) %><section class="auth-card"><p class="eyebrow">WELCOME BACK</p><h1>Log in to your account</h1><p class="muted">Find a calmer place to study on campus.</p><% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %><% if (error && error.length) { %><div class="alert" role="alert"><% error.forEach(message => { %><p><%= message %></p><% }) %></div><% } %><form action="/login" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required value="<%= (form && form.email) || '' %>"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required><button class="button" type="submit">Log in</button></form><p class="form-foot">New here? <a href="/register">Create an account</a></p></section><%- include('partials/footer') %>