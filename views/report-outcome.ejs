<%# LEGACY - not used by the Vue demo: confirmation page after a report is sent. Rendered by uploadReport in controllers/report-controller.js. The Vue page ReportFormView.vue replaces it. %>
<html>
    <head>
    <title>Report Outcome</title>
    <link rel="stylesheet" href="/styles.css">
</head>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
    <body>
        <%# Shows the saved report. %>
        <h2>Report sent successfully!</h2><br>
        Review: <%= reviewText %> <br>
        Reason for report: <%= report.reason %> <br>
        Description: <%= report.description %> <br>
        <%# Link to edit the report. %>
        <a href="/reports/edit/<%=reportId%>">Edit | </a>
        <a href="/">Back to Home</a>
    </body>
</html>