<%- include('partials/header', { title: 'Edit profile' }) %><section class="auth-card"><p class="eyebrow">ACCOUNT SETTINGS</p><h1>Edit your profile</h1><% if (error && error.length) { %><div class="alert" role="alert"><% error.forEach(message => { %><p><%= message %></p><% }) %></div><% } %><form action="/edit-profile" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="username">Username</label><input id="username" name="username" minlength="5" required value="<%= user.username %>"><label for="email">Email address</label><input id="email" name="email" type="email" required value="<%= user.email %>"><label for="password">New password <span class="hint">leave blank to keep current</span></label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password"><button class="button" type="submit">Save changes</button></form><p class="form-foot"><a href="/profile">Cancel</a></p></section><%- include('partials/footer') %>