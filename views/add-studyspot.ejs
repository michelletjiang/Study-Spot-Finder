<%# LEGACY - not used by the Vue demo: admin form to add a study spot. Rendered by showAddForm and createSpot in controllers/studyspot-controller.js. The Vue page SpotFormView.vue replaces it. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Add Study Spot</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
    <br>
    <h3>Add a New Study Spot</h3>
    <%# The form posts to the legacy /add-studyspot route. %>
    <form action="/add-studyspot" method="POST">
        <table border="1">
            <tr>
                <th>Building Name:</th>
                <td>
        <select name="buildingName">
            <option value="">-- Select a Building --</option>
            <%# One option per building from the controller. %>
            <% buildings.forEach(function(building) { %>
                <option value="<%= building.buildingname %>">
                    <%= building.buildingname %>
                </option>
            <% }); %>
        </select>
    </td>
            </tr>
            <tr>
                <th>Room Name:</th><td><input type="text" name="name"></td>
            </tr>
            <tr>
                <th>Floor:</th><td><input type="text" name="floor"></td>
            </tr>
            <tr>
                <th>Seat Count:</th><td><input type="number" name="seatCount"></td>
            </tr>
            <tr><th>Power Socket:</th>
                <td>
                    <%# The legacy handler turns the text "true" back into a boolean. %>
                    <select name="hasPowerSocket">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </td>
            </tr>
            <tr><th>Noise Level:</th>
                <td>
                    <%# The three noise levels the model accepts. %>
                    <select name="noiseLevel">
                        <option value="Quiet">Quiet</option>
                        <option value="Moderate">Moderate</option>
                        <option value="Loud">Loud</option>
                    </select>
                </td>
            </tr>
            <tr><td colspan="2"><button type="submit">Add Study Spot</button></td></tr>
        </table>
    </form>

    <br><br>
    <%# Show a validation message if there is one. %>
    <% if (msg !== '') { %>
        <p><%= msg %></p>
    <% } %>
    <%# Show the result of the last save attempt. %>
    <% if (result === 'fail') { %>
        <p>Failed to add study spot.</p>
    <% } else if (result && result.name) { %>
        <p>Study spot added successfully.</p>
        Building: <%= result.buildingName %><br>
        Room Name: <%= result.name %><br>
        Floor: <%= result.floor %><br>
        Seats: <%= result.seatCount %><br>
    <% } %>

    <br>
    <a href="/studyspot-list">Back to list</a>
</body>
</html>