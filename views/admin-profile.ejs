<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> |
            <a href="/admin/reports">Pending Reports</a> |
        <% } %>
        <a href="/favourites">Favourites</a> |
         <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Logout</button></form>
    </nav>
    <br>

    <h2>Welcome, Admin <%= user.username %>!🤩</h2>
    <p><strong>Username:</strong> <%= user.username %></p>
    <p><strong>Email:</strong> <%= user.email %></p>
    <p><strong>Your school(s):</strong></p>
    <ul>
        <% user.school.forEach(sch => { %>
            <li><%=sch%></li>
        <% }) %>
    </ul>
    <p><strong>Type of account:</strong> <%= user.role %></p>
    <p><strong>Member since: </strong><%= new Date(user.createdAt).toDateString() %></p>
    <a href="/favourites">Your Favourite Study Spots</a>
        <br>
        <a href="/reviews/<%= user.username %>">Your Reviews</a>
        <br><br>

    <form action="/edit-profile" method="GET">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Edit Profile</button>
        </form>

    <form action="/delete" method="POST">
            <button type="submit"> Delete Account</button>
        </form>

    <h3>Pending Admin Requests</h3>
    <% if (pendingRequests.length === 0) { %>
        <p>No pending requests.</p>
    <% } else { %>
        <table border="1" cellpadding="5">
            <tr>
                <th>Username</th>
                <th>Requested At</th>
                <th>Action</th>
            </tr>
            <% pendingRequests.forEach(req => { %>
            <tr>
                <td><%= req.username %></td>
                <td><%= new Date(req.createdAt).toDateString() %></td>
                <td>
                    <form action="/admin/requests/process" method="POST" style="display:inline">
                        <input type="hidden" name="requestId" value="<%= req._id %>">
                        <button type="submit" name="action" value="approve">Approve</button>
                        <button type="submit" name="action" value="deny">Deny</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>
    <% } %>
    <br>

</body>
</html>
