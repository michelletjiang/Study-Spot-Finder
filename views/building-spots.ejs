<%# LEGACY - not used by the Vue demo: server-rendered list of spots in one building, rendered by showBuildingSpots in controllers/building-controller.js. The Vue page BuildingSpotsView.vue replaces it and adds the Compare buttons, which this page does not have. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <%# The page title uses the building name from the URL. %>
    <title>Study Spots in <%= buildingname %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
    <br>
    
    <%# Heading with the building name. %>
    <h2>Study Spots in <%= buildingname %></h2>


    <%# No spots: show a message. %>
    <% if (studySpots.length === 0) { %>
        <p>No study spots found in this building.</p>
    <% } else { %>
        <%# Loop over the spots passed in by the controller. %>
        <% studySpots.forEach(function(spot) { %>
            <p><strong>Name: <%= spot.name %></strong></p>
            Building: <%= spot.buildingName %><br>
            Floor: <%= spot.floor %><br>
            Seats: <%= spot.seatCount %><br>
            Power Socket: <%= spot.hasPowerSocket ? 'Yes' : 'No' %><br>
            Noise Level: <%= spot.noiseLevel %><br>
            <%# Link to the legacy add-review form. %>
            <a href = '/add-review/<%= buildingname %>/<%= spot.name %>'>Add a Review</a><br>
            <%# Link to the legacy review list. %>
            <a href = '/review-list/<%= buildingname %>/ <%= spot.name %>'> View Reviews </a> <br>
            <%# Link that adds a favourite by sending the spot details in the query string. The server copies them from the link, which the JSON version avoids. %>
            <a href="/favourites/add?spotName=<%= spot.name %>&buildingName=<%= spot.buildingName %>&floor=<%= spot.floor %>&seatCount=<%= spot.seatCount %>&hasPowerSocket=<%= spot.hasPowerSocket %>&noiseLevel=<%= spot.noiseLevel %>">Add to Favourites</a>
            <hr>
        <% }); %>
    <% } %>

</body>
</html>