<%# LEGACY - not used by the Vue demo: server-rendered home page listing buildings. Rendered by showHome in controllers/building-controller.js. The Vue page HomeView.vue replaces it. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Find a Study Spot</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%# Navigation bar repeated on each legacy page. The role check below needs the user variable, which each handler must pass in. %>
    <nav>
        <a href ='/'><h2>Study Spots📚</h2></a>
        <a href='/profile'>Your Profile</a> |
        <%# Admins see the management links. %>
        <% if (user.role == 'Admin'){ %>
            <a href="/edit-buildings">Edit  Buildings</a> |
            <a href="/add-building">Add Building</a> |
            <a href="/studyspot-list">Edit Study Spots</a> |
            <a href="/add-studyspot">Add Study Spot</a> | 
            <a href="/admin/reports">Pending Reports</a> |
        <% } %> 
        <a href="/favourites">Favourites</a> |
         <%# Legacy logout is a GET link to /logout. %>
         <a href='/logout'>Logout</a>
    </nav>
    <%# Page heading and help text. %>
    <h2>Find a Study Spot</h2>
    <p>Select a building to see available study spots.</p>

    <%# No buildings: show a message. %>
    <% if (buildings.length === 0) { %>
        <p>No buildings available.</p>
    <%# Otherwise list each building. %>
    <% } else { %>
        <%# Loop over the buildings array passed in by the controller. %>
        <% buildings.forEach(function(building) { %>
            <%# Print values with the escaping tag, which turns special characters into safe text. %>
            <p><strong>Building: <%= building.buildingname %></strong></p>
            Floors: <%= building.floors %><br>
            Postal Code: <%= building.postal %><br>
            <%# Link to the legacy building page. %>
            <a href="/building/<%= building.buildingname %>">View Study Spots</a>
            <hr>
        <% }); %>
    <% } %>
</body>
</html>