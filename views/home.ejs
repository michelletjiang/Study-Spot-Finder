<%- include('partials/header', { title: 'Explore study spots' }) %><section class="hero"><div><p class="eyebrow">YOUR NEXT FOCUS SESSION</p><h1>Find your ideal<br><em>study spot.</em></h1><p class="lede">A simple way to discover spaces on campus that match the way you work.</p><% if (!user) { %><a class="button" href="/register">Get started</a><% } %></div><div class="hero-art">✦<br><span>Focus<br>better.</span></div></section><section class="section-head"><div><p class="eyebrow">DISCOVER</p><h2>Campus buildings</h2></div><span class="muted"><%= buildings.length %> available</span></section><div class="building-grid"><% if (!buildings.length) { %><div class="empty">No buildings available yet.</div><% } else { buildings.forEach(building => { %><article class="building-card"><span class="card-icon">⌂</span><h3><%= building.buildingname %></h3><p class="muted"><%= building.floors %> floors · <%= building.postal %></p><a href="/building/<%= building.buildingname %>">View study spots →</a></article><% }) } %></div><%- include('partials/footer') %>