<%- include('partials/header', { title: 'Your profile' }) %><section class="page-heading"><p class="eyebrow">ACCOUNT</p><h1>Your profile</h1><p class="muted">Manage your details and keep your study preferences close.</p></section><section class="profile-card"><div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div><div><h2><%= user.username %></h2><p class="muted"><%= user.role %> · Member since <%= new Date(user.createdAt).toDateString() %></p></div></section><dl class="details"><dt>Email</dt><dd><%= user.email %></dd><dt>School</dt><dd><%= user.school.join(', ') %></dd><dt>Access</dt><dd><span class="badge"><%= user.role %></span></dd></dl><div class="actions"><a class="button" href="/edit-profile">Edit profile</a><a class="button secondary" href="/">Explore study spots</a></div><% if (adminRequest && adminRequest.status === 'Pending') { %><div class="notice">Your admin access request is pending.</div><% } %><%- include('partials/footer') %>