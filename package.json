{
  "name": "study-spot-finder",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js && vitest run",
    "start": "node server.js",
    "dev": "concurrently -n server,client -c blue,green \"node --watch server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "geocode": "node scripts/geocode-buildings.js",
    "seed:spots": "node scripts/seed-floorplan-spots.js",
    "seed:noise": "node scripts/seed-noise-reports.js",
    "set:basements": "node scripts/set-basements.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "seed:law": "node scripts/seed-law-data.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.6",
    "vitest": "^4.1.10"
  }
}
